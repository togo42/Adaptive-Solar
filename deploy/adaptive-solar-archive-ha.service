[Unit]
Description=Adaptive Solar archive ha

[Service]
Type=oneshot
WorkingDirectory=%h/adaptive-solar-archive/current
ExecStart=%h/adaptive-solar-archive/current/.venv/bin/python %h/adaptive-solar-archive/current/scripts/archive_host.py ha --config %h/adaptive-solar-archive/current/data/host.json
LoadCredentialEncrypted=ha-auth:%h/.config/adaptive-solar-archive/ha-auth.cred
UMask=0077
NoNewPrivileges=yes
TimeoutStartSec=30min
KillMode=control-group
StandardOutput=journal
StandardError=journal
